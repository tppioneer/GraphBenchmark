{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphbenchmark.dev/schemas/ground-truth.schema.json",
  "title": "Ground Truth Rubric",
  "description": "Auditable scoring rubric for a case. GT authors explicitly assign per-item points; the Profile only constrains per-dimension totals (see docs/ai-scoring-design.md §7). Structural invariants are enforced here; rubric business validation (unique ids, dimension/total point sums, critical zero-credit presence) is performed by the rubric validator task and is out of scope for AIS-002. Business version is locked via schema_version.",
  "type": "object",
  "required": ["schema_version", "case_id", "task_type", "scoring_profile", "rubric_items"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ground-truth-v1",
      "description": "Locked business version for the ground-truth contract."
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "enum": ["flow_tracing", "bug_localization", "impact_analysis"]
    },
    "scoring_profile": {
      "enum": ["flow_tracing_v1", "bug_localization_v1", "impact_analysis_v1"]
    },
    "rubric_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rubricItem"
      }
    }
  },
  "$defs": {
    "rubricItem": {
      "type": "object",
      "required": ["id", "dimension", "points", "criterion"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable, unique rubric item identifier. Never exposed to the agent."
        },
        "dimension": {
          "enum": [
            "core_correctness",
            "reasoning_correctness",
            "completeness",
            "scope_precision",
            "evidence_actionability"
          ]
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "full_credit": {
          "type": "string"
        },
        "partial_credit": {
          "type": "string"
        },
        "zero_credit": {
          "type": "string",
          "description": "Required for critical items (enforced by rubric business validation)."
        },
        "critical": {
          "type": "boolean",
          "default": false
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["symbol", "file"],
            "additionalProperties": false,
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "type": "string",
                "minLength": 1
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    }
  }
}
