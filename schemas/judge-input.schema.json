{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphbenchmark.dev/schemas/judge-input.schema.json",
  "title": "Judge Blind Input",
  "description": "Blinded input package handed to the AI Judge (see docs/ai-scoring-design.md §9). It MUST NOT contain experiment-group-leaking fields: agent name, model name, tool_policy, tool calls, metrics, prior scores, or Judge tool access. additionalProperties=false enforces the closed content set. The package records input digests (agent answer, GT, prompt), profile version and blinding protocol version. Business version is locked via schema_version.",
  "type": "object",
  "required": [
    "schema_version",
    "judge_protocol",
    "scoring_profile",
    "task_type",
    "case_id",
    "question",
    "rubric_items",
    "answer",
    "digests"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "judge-input-v1",
      "description": "Locked business version for the judge-input contract."
    },
    "judge_protocol": {
      "const": "semantic_outcome_v1"
    },
    "scoring_profile": {
      "enum": ["flow_tracing_v1", "bug_localization_v1", "impact_analysis_v1"]
    },
    "task_type": {
      "enum": ["flow_tracing", "bug_localization", "impact_analysis"]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "profile_brief": {
      "type": "string",
      "description": "Profile scoring guidance for the Judge (dimension interpretations)."
    },
    "rubric_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rubricItem"
      }
    },
    "answer": {
      "type": "object",
      "required": ["summary", "explanation"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "excerpts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excerpt"
      },
      "description": "GT-author-preselected static source excerpts; the Judge cannot fetch its own (§9.1)."
    },
    "digests": {
      "type": "object",
      "required": [
        "agent_answer_digest",
        "ground_truth_digest",
        "judge_prompt_digest",
        "profile_version",
        "blinding_protocol_version"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_answer_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "ground_truth_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "judge_prompt_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "blinding_protocol_version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "rubricItem": {
      "type": "object",
      "required": ["id", "dimension", "points", "criterion"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "enum": [
            "core_correctness",
            "reasoning_correctness",
            "completeness",
            "scope_precision",
            "evidence_actionability"
          ]
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "full_credit": {
          "type": "string"
        },
        "partial_credit": {
          "type": "string"
        },
        "zero_credit": {
          "type": "string"
        },
        "critical": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "kind", "claim"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "file", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "excerpt": {
      "type": "object",
      "required": ["file", "revision", "start_line", "end_line", "digest", "content"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "content": {
          "type": "string",
          "maxLength": 12000,
          "description": "Per-excerpt character cap (§9.1). The 80-line and per-case 40000-char limits are enforced by the runner (business rule)."
        }
      }
    }
  }
}
