{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphbenchmark.dev/schemas/policy-result.schema.json",
  "title": "Policy Result",
  "description": "Tool-policy and artifact-compliance result produced by the Runner or policy validator (see docs/ai-scoring-design.md §8.7). The agent cannot affect experiment validity by misreporting these fields. Business version is locked via schema_version.",
  "type": "object",
  "required": ["schema_version", "valid", "violations", "observations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "policy-result-v1",
      "description": "Locked business version for the policy-result contract."
    },
    "valid": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": ["warning", "error"]
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
